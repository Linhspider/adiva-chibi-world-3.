rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /artifacts/{appId}/public/data/multiplayer_rooms/{roomId} {
      allow read, create, update: if signedIn();
      match /players/{playerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == playerId;
        allow delete: if signedIn() && request.auth.uid == playerId;
      }
    }
  }
}
